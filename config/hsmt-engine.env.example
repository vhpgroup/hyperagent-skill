# Bind to localhost when OpenClaw runs on the same server.
HSMT_API_HOST=127.0.0.1
HSMT_API_PORT=8787
HSMT_MAX_UPLOAD_MB=100
HSMT_API_TOKEN=replace-with-a-long-random-token

# Existing Exa key can remain in ~/.config/hyperagent/secrets.env.
RESEARCH_BACKEND=exa

# Optional OpenAI-compatible model. Without it, candidates are returned as
# "Cần xác minh" and must be reviewed manually.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
